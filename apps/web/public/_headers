# Cloudflare Workers static assets (wrangler.json). The same headers as
# nginx-security-headers.conf, which the Docker image uses instead.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
# The service worker and the manifest are revalidated on every check, so a new
# build is found as soon as it is deployed (nginx.conf does the same).
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
# The game creation guide and its scripts open in a browser tab, with the
# same types as nginx.conf's /skills/ block.
/skills/*.md
  Content-Type: text/plain; charset=utf-8
/skills/*.mjs
  Content-Type: text/javascript; charset=utf-8

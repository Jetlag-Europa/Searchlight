# Cloudflare Workers static assets (wrangler.json). The same headers as
# nginx-security-headers.conf, which the Docker image uses instead.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
# The service worker and the manifest are revalidated on every check, so a new
# build is found as soon as it is deployed (nginx.conf does the same).
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache

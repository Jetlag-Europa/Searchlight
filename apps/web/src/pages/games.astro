---
import Layout from "@/layouts/Layout.astro";
import { AuthGuard } from "@/components/AuthGuard";
import { GameManager } from "@/components/GameManager";
---

<Layout>
    <!--
        Auth loading overlay — same pattern as /map and /admin.
        AuthGuard removes it once /me responds 200, or while it retries an unreachable server.
    -->
    <div
        id="auth-loading-overlay"
        class="fixed inset-0 z-[9999] flex items-center justify-center bg-background"
    >
        <div
            class="h-8 w-8 animate-spin rounded-full border-2 border-white border-t-transparent"
        >
        </div>
    </div>

    <AuthGuard client:only="react" />

    <main class="container mx-auto max-w-4xl px-4 py-6 sm:p-8">
        <a href="/map" class="inline-block text-xs text-muted-foreground underline mb-2">
            ← Back to map
        </a>
        <h1 class="text-2xl font-bold mb-2">Game Management</h1>
        <p class="text-sm text-muted-foreground mb-8">
            Upload and manage the games you can start sessions with. You see Casual Games,
            where anyone in one of the JetLag Discord servers can upload their own, plus every
            server where you have a game role. Server admins also see how much each game is
            played.
        </p>
        <GameManager client:only="react" />
    </main>
</Layout>

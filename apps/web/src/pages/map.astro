---
import Layout from "@/layouts/Layout.astro";
import { Map } from "@/components/Map";
import {
    SidebarProvider as SidebarProviderL,
    SidebarTrigger as SidebarTriggerL,
} from "@/components/ui/sidebar-l";
import {
    SidebarProvider as SidebarProviderR,
    SidebarTrigger as SidebarTriggerR,
} from "@/components/ui/sidebar-r";
import { QuestionSidebar } from "@/components/QuestionSidebar";
import { ZoneSidebar } from "@/components/ZoneSidebar";
import { OptionDrawers } from "@/components/OptionDrawers";
import { AnnotationToolbar } from "@/annotations";
import { AuthGuard } from "@/components/AuthGuard";
import { SessionManager } from "@/components/SessionManager";
import { SyncIndicator } from "@/components/SyncIndicator";
import { CalculatingIndicator } from "@/components/CalculatingIndicator";
import { ZonesLeftIndicator } from "@/components/ZonesLeftIndicator";
import { PreferencesSync } from "@/components/PreferencesSync";
import { SessionUpgradeBanner } from "@/components/SessionUpgradeBanner";
---
<Layout className="bg-jetlag">
    <!--
        Auth loading overlay — visible immediately (no JS required).
        AuthGuard removes it once /me responds 200, so map content
        is never visible to an unauthenticated visitor. It also removes it
        while the server can't be reached: no session loads before /me
        answers 200, so only the empty map shows.
    -->
    <div
        id="auth-loading-overlay"
        class="fixed inset-0 z-[9999] flex items-center justify-center bg-background"
    >
        <div
            class="h-8 w-8 animate-spin rounded-full border-2 border-white border-t-transparent"
        >
        </div>
    </div>


    <!-- AuthGuard fetches /me; on 401 redirects to the login page (with ?returnTo=); on 200 removes the overlay and renders the user chip; otherwise it retries -->
    <AuthGuard client:only="react" />

    <!-- SessionManager shows blocking overlay until a session is selected, then persists session state -->
    <SessionManager client:only="react" />

    <!-- PreferencesSync loads user preferences from server and saves changes back -->
    <PreferencesSync client:only="react" />

    <!-- SyncIndicator shows offline/syncing/synced status -->
    <SyncIndicator client:only="react" />

    <!-- CalculatingIndicator shows question results that take a while to work out -->
    <CalculatingIndicator client:only="react" />

    <!-- ZonesLeftIndicator shows how many hiding zones are left, in the same spot -->
    <ZonesLeftIndicator client:only="react" />

    <!-- The board; SessionManager makes it inert while the session picker is open -->
    <div id="map-board" class="contents">
        <SidebarProviderL client:load>
            <SidebarProviderR client:load defaultOpen={false}>
                <QuestionSidebar client:only />
                <main class="flex h-svh min-w-0 flex-col flex-grow group">
                    <div
                        id="map-modal-dialog-container-leaflet"
                        class="min-h-0 flex-1"
                    >
                        <div class="w-full h-full relative">
                            <div
                                class="absolute top-[72px] md:top-2 left-2 z-[1030] group-[.fullscreen]:hidden"
                            >
                                <SidebarTriggerL client:load />
                            </div>
                            <div
                                class="absolute top-[72px] md:top-2 right-2 z-[1030] group-[.fullscreen]:hidden"
                            >
                                <SidebarTriggerR client:load />
                            </div>
                            <div
                                class="bottom-5 left-2 right-2 mb-2 absolute z-[1030] group-[.fullscreen]:hidden"
                            >
                                <OptionDrawers client:only />
                            </div>
                            <div
                                class="right-2 top-1/2 -translate-y-1/2 absolute z-[1030] group-[.fullscreen]:hidden max-h-[80vh] overflow-y-auto"
                            >
                                <AnnotationToolbar client:only />
                            </div>
                            <Map
                                className="w-full !h-full group-[.fullscreen]:w-full"
                                client:only
                            />
                        </div>
                    </div>
                    <!-- SessionManager renders the "game not loaded" banner here -->
                    <div id="game-not-loaded-banner" class="contents"></div>
                    <SessionUpgradeBanner client:only="react" />
                </main>
                <ZoneSidebar client:only />
            </SidebarProviderR>
        </SidebarProviderL>
    </div>
</Layout>

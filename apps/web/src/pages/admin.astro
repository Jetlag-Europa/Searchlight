---
import Layout from "@/layouts/Layout.astro";
import { AuthGuard } from "@/components/AuthGuard";
import { AdminPanel } from "@/components/AdminPanel";
import { UsagePanel } from "@/components/UsagePanel";
import { AuditLogPanel } from "@/components/AuditLogPanel";
---

<Layout>
    <!--
        Auth loading overlay — same pattern as /map.
        AuthGuard removes it once /me responds 200, or while it retries an unreachable server.
    -->
    <div
        id="auth-loading-overlay"
        class="fixed inset-0 z-[9999] flex items-center justify-center bg-background"
    >
        <div
            class="h-8 w-8 animate-spin rounded-full border-2 border-white border-t-transparent"
        >
        </div>
    </div>

    <AuthGuard client:only="react" />

    <main class="container mx-auto max-w-4xl px-4 py-6 sm:p-8">
        <h1 class="text-2xl font-bold mb-1">Admin</h1>
        <p class="text-sm text-muted-foreground mb-6">
            Give Discord roles permissions on each server, and see who changed what.
            You can manage servers where you hold <code>server.admin</code>.
        </p>
        <h2 class="text-lg font-semibold mb-3">Servers</h2>
        <AdminPanel client:only="react" />
        <AuditLogPanel client:only="react" />
        <UsagePanel client:only="react" />
    </main>
</Layout>

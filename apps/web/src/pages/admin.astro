---
import Layout from "@/layouts/Layout.astro";
import { AuthGuard } from "@/components/AuthGuard";
import { AdminPanel } from "@/components/AdminPanel";
---

<Layout>
    <!--
        Auth loading overlay — same pattern as /map.
        AuthGuard removes it once /me responds 200, or while it retries an unreachable server.
    -->
    <div
        id="auth-loading-overlay"
        class="fixed inset-0 z-[9999] flex items-center justify-center bg-background"
    >
        <div
            class="h-8 w-8 animate-spin rounded-full border-2 border-white border-t-transparent"
        >
        </div>
    </div>

    <AuthGuard client:only="react" />

    <main class="container mx-auto max-w-4xl p-8">
        <h1 class="text-2xl font-bold mb-2">Server Admin</h1>
        <p class="text-sm text-muted-foreground mb-8">
            Map Discord roles to permissions for each JetLag server.
            Only servers where you hold <code>server.admin</code> show the role management panel.
        </p>
        <AdminPanel client:only="react" />
    </main>
</Layout>

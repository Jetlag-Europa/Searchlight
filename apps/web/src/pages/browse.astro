---
import Layout from "@/layouts/Layout.astro";
import { AuthGuard } from "@/components/AuthGuard";
import { GameBrowser } from "@/components/GameBrowser";
---

<Layout>
    <!-- Same auth overlay as /map and /games; AuthGuard removes it once /me responds 200. -->
    <div
        id="auth-loading-overlay"
        class="fixed inset-0 z-[9999] flex items-center justify-center bg-background"
    >
        <div
            class="h-8 w-8 animate-spin rounded-full border-2 border-white border-t-transparent"
        >
        </div>
    </div>

    <AuthGuard client:only="react" />

    <main class="container mx-auto max-w-5xl px-4 pb-12 pt-16 sm:px-8">
        <a href="/map" class="text-sm text-muted-foreground hover:text-foreground">← Back to the map</a>
        <h1 class="mt-3 text-2xl font-bold">Find a game</h1>
        <p class="mb-6 mt-1 text-sm text-muted-foreground">
            The games of all your servers. Search for a city or
            region to see the games played there, then start a session with
            one click. Some servers also show their games to non-members,
            greyed out: join the server on Discord to play them.
        </p>
        <GameBrowser client:only="react" />
    </main>
</Layout>

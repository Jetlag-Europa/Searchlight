        "@fastify/type-provider-typebox": "^5.0.0",
        "@prisma/client": "^6.0.0",
        "@sinclair/typebox": "^0.34.0",
        "@taibled/shared": "workspace:*",
        "arctic": "^3.0.0",
        "fastify": "^5.2.2",
        "prisma": "^6.0.0"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "tsx": "^4.19.2",
        "typescript": "^5.7.3",
        "vitest": "^3.1.4"
    },
    "engines": {
        "node": "<25"

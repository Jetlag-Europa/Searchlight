{
    "name": "@searchlight/api",
    "version": "2.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "pnpm prisma migrate deploy && pnpm seed --missing-only && node --env-file=../../.env --watch --import tsx/esm src/index.ts",
        "prisma": "node --env-file=../../.env node_modules/prisma/build/index.js",
        "build": "tsc",
        "build:seed": "tsc -p tsconfig.seed.json",
        "start": "node dist/index.js",
        "test": "vitest run",
        "seed": "tsx --env-file=../../.env prisma/seed.ts",
        "seed:test": "tsx --env-file=../../.env prisma/seed-test.ts",
        "seed:prod": "node dist-seed/seed.js",
        "validate-game": "tsx scripts/validate-game.ts",
        "postinstall": "prisma generate"
    },
    "dependencies": {
        "@fastify/cookie": "^11.0.2",
        "@fastify/cors": "^10.0.2",
        "@fastify/type-provider-typebox": "^5.0.0",
        "@prisma/client": "^6.0.0",
        "@sinclair/typebox": "^0.34.0",
        "@searchlight/shared": "workspace:*",
        "arctic": "^3.0.0",
        "fastify": "^5.2.2",
        "prisma": "^6.0.0"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "tsx": "^4.19.2",
        "typescript": "^5.7.3",
        "vitest": "^3.1.4"
    },
    "engines": {
        "node": "<25"
    },
    "prisma": {
        "seed": "tsx prisma/seed.ts"
    }
}

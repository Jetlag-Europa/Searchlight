generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  discordId             String       @id
  username              String
  displayName           String
  avatarUrl             String
  discordAccessToken    String
  discordRefreshToken   String
  discordTokenExpiresAt DateTime
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  sessions              AuthSession[]
}

model AuthSession {
  // id is a 256-bit random hex token (32 bytes via crypto.randomBytes)
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [discordId])
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

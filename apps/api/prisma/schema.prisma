generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Visibility {
  private
  shared
}

enum ParticipantRole {
  creator
  member
}

model User {
  discordId             String       @id
  username              String
  displayName           String
  avatarUrl             String
  discordAccessToken    String
  discordRefreshToken   String
  discordTokenExpiresAt DateTime
  preferences           Json?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  sessions              AuthSession[]
  membershipCaches      ServerMembershipCache[]
  createdSessions       GameSession[]          @relation("SessionCreator")
  sessionParticipants   SessionParticipant[]
  strokes               Stroke[]
  events                Event[]
  createdLinks          SessionLink[]          @relation("CreatedLinks")
  createdGameLinks      GameLink[]             @relation("CreatedGameLinks")
}

model AuthSession {
  // id is a 256-bit random hex token (32 bytes via crypto.randomBytes)
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [discordId])
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Server {
  id                String   @id // Discord guild ID
  name              String
  iconUrl           String?
  managementGuildId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  membershipCaches ServerMembershipCache[]
  rolePermissions  RolePermission[]
  games            Game[]
  gameSessions     GameSession[]
  importTokens     GameImportToken[]
}

model ServerMembershipCache {
  userId   String
  serverId String
  isMember Boolean  @default(false) // false: Discord reported the user is not in the guild
  roles    String[] // Discord role ID strings
  cachedAt DateTime

  user   User   @relation(fields: [userId],   references: [discordId])
  server Server @relation(fields: [serverId], references: [id])

  @@id([userId, serverId])
}

model RolePermission {
  id            Int    @id @default(autoincrement())
  serverId      String
  discordRoleId String
  permission    String

  server Server @relation(fields: [serverId], references: [id])

  @@unique([serverId, discordRoleId, permission])
  @@index([serverId])
}

model Game {
  id                String         @id @default(cuid())
  gameKey           String         @unique
  serverId          String
  name              String
  size              String         @default("medium") // "small" | "medium" | "large"
  // Hidden from game lists and closed to direct use except for the server's
  // game managers; anyone else needs a GameLink.
  unlisted          Boolean        @default(false)
  currentRevisionId String?
  // Checksum of its games/preloaded file at the last API start that saw it
  // (null if never preloaded): the file only changes the game when its
  // content changes.
  preloadChecksum   String?
  archivedAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  server          Server         @relation(fields: [serverId], references: [id])
  sessions        GameSession[]
  revisions       GameRevision[]
  currentRevision GameRevision?  @relation("CurrentGameRevision", fields: [currentRevisionId], references: [id])
  links           GameLink[]

  @@index([serverId])
  @@index([currentRevisionId])
}

// A link anyone can use to start sessions of a game, whether or not it is
// listed and whether or not they could reach the game otherwise. Links only end
// when revoked; listing or unlisting the game doesn't touch them.
model GameLink {
  id          String    @id @default(cuid())
  token       String    @unique
  gameId      String
  createdById String
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  game      Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  createdBy User          @relation("CreatedGameLinks", fields: [createdById], references: [discordId])
  sessions  GameSession[]

  @@index([gameId])
}

model GameRevision {
  id            String       @id @default(cuid())
  gameId        String
  revision      Int
  formatVersion Int          @default(1)
  definition    Json
  checksum      String
  source        String       @default("api") // "api" | "web" | "preload" | "migration"
  createdBy     String?
  createdAt     DateTime     @default(now())

  game       Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  currentFor Game[]        @relation("CurrentGameRevision")
  sessions        GameSession[]
  linkSnapshots   LinkSnapshot[]

  @@unique([gameId, revision])
  @@unique([gameId, checksum])
  @@index([gameId])
  @@index([checksum])
}

model GameImportToken {
  id          String    @id @default(cuid())
  name        String
  tokenHash   String    @unique
  serverId    String
  permissions String[]  // e.g. ["games.create", "games.edit"]
  createdBy   String
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  server Server @relation(fields: [serverId], references: [id])

  @@index([serverId])
  @@index([tokenHash])
}

model GameSession {
  id         String          @id @default(cuid())
  gameId     String
  serverId   String
  creatorId  String
  name       String
  visibility Visibility      @default(private)
  hiderLat            Float?
  hiderLng            Float?
  planningModeEnabled Boolean       @default(false)
  gameRevisionId      String
  // The game link the session was started from, if any. While it is active,
  // the creator may upgrade the session without other access to the game.
  gameLinkId          String?
  eventSequence       Int           @default(0)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  game         Game                 @relation(fields: [gameId], references: [id])
  gameRevision GameRevision         @relation(fields: [gameRevisionId], references: [id])
  gameLink     GameLink?            @relation(fields: [gameLinkId], references: [id], onDelete: SetNull)
  server       Server               @relation(fields: [serverId], references: [id])
  creator      User                 @relation("SessionCreator", fields: [creatorId], references: [discordId])
  participants SessionParticipant[]
  strokes      Stroke[]
  questions    SessionQuestion[]
  events       Event[]
  links        SessionLink[]

  @@index([serverId])
  @@index([creatorId])
  @@index([gameRevisionId])
  @@index([gameLinkId])
}
model SessionParticipant {
  sessionId  String
  userId     String
  role       ParticipantRole
  invitedAt  DateTime        @default(now())
  acceptedAt DateTime?
  revokedAt  DateTime?

  session GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId],    references: [discordId])

  @@id([sessionId, userId])
  @@index([userId])
}

model SessionLink {
  id          String    @id @default(cuid())
  token       String    @unique
  sessionId   String
  createdById String
  linkType    String    // "join" | "fork"
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  session   GameSession  @relation(fields: [sessionId],   references: [id], onDelete: Cascade)
  createdBy User         @relation("CreatedLinks", fields: [createdById], references: [discordId])
  snapshot  LinkSnapshot?

  @@index([sessionId])
}

model LinkSnapshot {
  id             String        @id @default(cuid())
  linkId         String        @unique
  questions      Json          // Array of { payloadJson, ordinal, clientUuid }
  gameRevisionId String?
  createdAt      DateTime      @default(now())

  link           SessionLink   @relation(fields: [linkId], references: [id], onDelete: Cascade)
  gameRevision   GameRevision? @relation(fields: [gameRevisionId], references: [id], onDelete: SetNull)

  @@index([gameRevisionId])
}

model Stroke {
  id          String    @id @default(cuid())
  sessionId   String
  userId      String
  payloadJson Json
  clientUuid  String    @unique
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  session GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId],    references: [discordId])

  @@index([sessionId])
}

model SessionQuestion {
  id          String   @id @default(cuid())
  sessionId   String
  payloadJson Json
  ordinal     Int
  clientUuid  String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  session GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, ordinal])
}

model Event {
  id               String   @id @default(cuid())
  sessionId        String
  userId           String
  sequence         Int
  type             String   // "stroke.create" | "stroke.delete" | "questions.replace" | "hider.update" | "planning.toggle" | "session.revision-upgraded"
  payloadJson      Json
  clientUuid       String   @unique
  clientCreatedAt  DateTime
  serverReceivedAt DateTime @default(now())

  session GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [discordId])

  @@index([sessionId, serverReceivedAt])
  @@unique([sessionId, sequence])
}

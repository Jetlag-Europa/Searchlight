generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  discordId             String       @id
  username              String
  displayName           String
  avatarUrl             String
  discordAccessToken    String
  discordRefreshToken   String
  discordTokenExpiresAt DateTime
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  sessions              AuthSession[]
  membershipCaches      ServerMembershipCache[]
}

model AuthSession {
  // id is a 256-bit random hex token (32 bytes via crypto.randomBytes)
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [discordId])
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Server {
  id        String   @id // Discord guild ID
  name      String
  iconUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  membershipCaches ServerMembershipCache[]
  rolePermissions  RolePermission[]
}

model ServerMembershipCache {
  userId   String
  serverId String
  roles    String[] // Discord role ID strings
  cachedAt DateTime

  user   User   @relation(fields: [userId],   references: [discordId])
  server Server @relation(fields: [serverId], references: [id])

  @@id([userId, serverId])
}

model RolePermission {
  id            Int    @id @default(autoincrement())
  serverId      String
  discordRoleId String
  permission    String

  server Server @relation(fields: [serverId], references: [id])

  @@unique([serverId, discordRoleId, permission])
  @@index([serverId])
}

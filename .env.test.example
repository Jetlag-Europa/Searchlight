# Overrides for the writemap-test e2e stack (docker-compose.test.yml).
# Copy to .env.test. Loaded AFTER .env, so only override what differs for tests.
#
# The web app is served at http://127.0.0.1:8280 and the API at
# http://127.0.0.1:3200 — both are "localhost" so the SameSite=Lax session cookie
# is sent on cross-port (same-site) requests. FRONTEND_ORIGIN must match the web
# origin or CORS will block credentialed calls.
FRONTEND_ORIGIN=http://127.0.0.1:8280

# Discord OAuth is unused in the test stack (test-login bypasses it), but env.ts
# still requires these to be present — placeholders are fine.
DISCORD_REDIRECT_URI=http://127.0.0.1:3200/auth/discord/callback

# Optional: the discordId the default test-login mints / seed-test creates.
# TEST_AUTH_USER_ID=e2e-test-user

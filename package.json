{
  "name": "searchlight",
  "version": "2.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": "<25"
  },
  "scripts": {
    "dev": "docker compose -f docker-compose.dev.yml up -d --wait && pnpm --filter @searchlight/shared build && pnpm --recursive --parallel dev",
    "build": "pnpm -r build",
    "generate:game-schema": "tsx scripts/generate-game-json-schema.ts",
    "check:game-schema": "tsx scripts/generate-game-json-schema.ts --check",
    "fix:region-overlaps": "tsx scripts/fix-region-overlaps.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.5.3",
    "tsx": "^4.23.15"
  }
}

{
    "name": "searchlight",
    "private": true,
    "packageManager": "pnpm@11.1.3",
    "engines": {
        "node": "<25"
    },
    "scripts": {
        "dev": "docker compose -f docker-compose.dev.yml up -d --wait && pnpm --filter @searchlight/shared build && pnpm --recursive --parallel dev",
        "build": "pnpm -r build",
        "generate:game-schema": "tsx scripts/generate-game-json-schema.ts",
        "check:game-schema": "tsx scripts/generate-game-json-schema.ts --check",
        "verify:preloaded-games": "tsx scripts/verify-preloaded-games.ts"
    },
    "devDependencies": {
        "tsx": "^4.19.2"
    }
}

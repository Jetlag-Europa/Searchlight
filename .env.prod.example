# Server: `cp .env.prod.example .env`, fill in every empty value and
# `chmod 600 .env`. See DEPLOY.md.

# ── Compose ──────────────────────────────────────────────────────────────────
# The project name scopes the Postgres volume (<name>_postgres_data): never
# change it on a running server. The production server uses `writemap`.
COMPOSE_PROJECT_NAME=writemap
# Full stack behind a Cloudflare Tunnel:
COMPOSE_FILE=docker-compose.yml:docker-compose.cloudflared.yml
# Or API + Postgres only, the web app hosted elsewhere:
# COMPOSE_FILE=docker-compose.yml:docker-compose.backend.yml
# API_BIND=0.0.0.0
# API_PORT=3000
# Tunnel credentials and config.yml (default: ../cloudflared, next to the clone).
# CLOUDFLARED_DIR=

# ── Postgres ─────────────────────────────────────────────────────────────────
# Fixed when the volume is first created. Keep it URL-safe (it goes into the
# API's connection string): openssl rand -hex 32
POSTGRES_PASSWORD=

# ── Discord ──────────────────────────────────────────────────────────────────
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# Must be registered under OAuth2 → Redirects in the Discord app.
DISCORD_REDIRECT_URI=https://api-searchlight.jetlageuropa.org/auth/discord/callback
# Discord user IDs with every permission on every server (comma-separated).
ADMIN_DISCORD_IDS=

# ── Web ──────────────────────────────────────────────────────────────────────
# Rotating it logs everyone out: openssl rand -hex 32
SESSION_COOKIE_SECRET=
# Exact origin of the web app (CORS, no trailing slash).
FRONTEND_ORIGIN=https://searchlight.jetlageuropa.org
# API URL baked into the web image when it is built on this server
# (`infra/deploy.sh --build`). The CI image always uses the production URL.
PUBLIC_API_BASE=https://api-searchlight.jetlageuropa.org

# ── Optional ─────────────────────────────────────────────────────────────────
# Discord webhook that receives feedback posts.
# DISCORD_FEEDBACK_WEBHOOK_URL=
# Self-hosted Overpass for free play and OSM boundary lookups (default: the
# public servers), plus its Cloudflare Access service token if it has one.
# OVERPASS_URL=https://<host>/api/interpreter
# OVERPASS_CF_ACCESS_CLIENT_ID=
# OVERPASS_CF_ACCESS_CLIENT_SECRET=

# Dev server environment — /srv/WriteMap-Dev/TaibledFork/.env
# Copy this file, fill in the values, chmod 600 it.
# See .env.example for field descriptions.

# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_USER=taibled_dev
POSTGRES_PASSWORD=change_me_dev

# Internal Docker service name 'postgres' resolves within the dev stack network
DATABASE_URL=postgresql://taibled_dev:change_me_dev@postgres:5432/taibled

# ── Discord Bot (required: membership and roles are read with it) ─────────────
DISCORD_BOT_TOKEN=

# ── Discord OAuth ─────────────────────────────────────────────────────────────
# Same Discord app as prod — both redirect URIs must be registered in the portal
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://apidevhideandseek.lucifersserver.com/auth/discord/callback

# ── Sessions ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# MUST be different from prod — different secret means cross-env cookies are rejected
SESSION_COOKIE_SECRET=
# Leave blank — cookie bound to exact host (devhideandseek.lucifersserver.com)
# No overlap with prod cookies possible since the hostnames differ entirely
SESSION_COOKIE_DOMAIN=

# ── CORS / origins ────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=https://devhideandseek.lucifersserver.com

# ── Frontend build ────────────────────────────────────────────────────────────
PUBLIC_API_BASE=https://apidevhideandseek.lucifersserver.com

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=production

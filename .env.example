# Copy this file to .env and fill in the values.
# Never commit .env — it is covered by .gitignore.

# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_USER=taibled
POSTGRES_PASSWORD=change_me

# Full Prisma connection string (matches the postgres service above)
DATABASE_URL=postgresql://taibled:change_me@postgres:5432/taibled

# ── Discord Bot (optional) ────────────────────────────────────────────────────
# Enables role name display in the admin UI. From the Bot section of your Discord app.
# Not required for auth or permissions to work — role IDs are used as fallback.
DISCORD_BOT_TOKEN=

# ── Discord OAuth ─────────────────────────────────────────────────────────────
# From https://discord.com/developers/applications → your app → OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Registered redirect URI (must match exactly what Discord expects)
# Dev:  http://localhost:3000/auth/discord/callback
# Prod: https://api.hideandseek.lucifersserver.com/auth/discord/callback
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# ── Sessions ──────────────────────────────────────────────────────────────────
# Long random string used to sign session cookies — generate with:
#   openssl rand -hex 32
SESSION_COOKIE_SECRET=
# Prod only: domain attribute for the session cookie (e.g. .hideandseek.lucifersserver.com)
# Leave blank for dev — cookies are bound to host when this is unset
SESSION_COOKIE_DOMAIN=

# ── CORS / origins ────────────────────────────────────────────────────────────
# Exact origin of the frontend (no trailing slash)
# Dev:  http://localhost:8080
# Prod: https://hideandseek.lucifersserver.com
FRONTEND_ORIGIN=http://localhost:8080

# ── Frontend build ────────────────────────────────────────────────────────────
# Baked into the web container at build time (PUBLIC_ prefix exposes to the browser)
# Dev:  http://localhost:3000
# Prod: https://api.hideandseek.lucifersserver.com
PUBLIC_API_BASE=http://localhost:3000

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=production

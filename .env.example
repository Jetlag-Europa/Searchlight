# Copy this file to .env and fill in the values (local development: see
# SETUP.md). Production on the VPS uses .env.vps.example instead.
# Never commit .env — it is covered by .gitignore.

# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_USER=taibled
POSTGRES_PASSWORD=change_me

# Full Prisma connection string (matches the postgres service above)
DATABASE_URL=postgresql://taibled:change_me@postgres:5432/taibled

# ── Discord Bot (required) ────────────────────────────────────────────────────
# From the Bot section of your Discord app. The API refuses to start without it:
# server membership, roles and role names are read with the bot, so it must be
# in every server whose games should be visible.
DISCORD_BOT_TOKEN=

# ── Discord OAuth ─────────────────────────────────────────────────────────────
# From https://discord.com/developers/applications → your app → OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Registered redirect URI (must match exactly what Discord expects)
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# ── Sessions ──────────────────────────────────────────────────────────────────
# Long random string used to sign session cookies — generate with:
#   openssl rand -hex 32
SESSION_COOKIE_SECRET=
# Optional domain attribute for the session cookie. Leave blank: cookies are
# then bound to the API host
SESSION_COOKIE_DOMAIN=

# ── CORS / origins ────────────────────────────────────────────────────────────
# Exact origin of the frontend (no trailing slash)
FRONTEND_ORIGIN=http://localhost:8080

# ── Frontend build ────────────────────────────────────────────────────────────
# Baked into the web container at build time (PUBLIC_ prefix exposes to the browser)
PUBLIC_API_BASE=http://localhost:3000

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=production
# Optional: comma-separated Discord user IDs that get every permission on every
# server and skip the membership/role checks (handy for local development).
# ADMIN_DISCORD_IDS=
# Optional: bind a test-only API to loopback (default is 0.0.0.0 for containers).
# Never expose ENABLE_TEST_AUTH=1 on a public interface.
# HOST=127.0.0.1

# Local development: `cp .env.example .env`, then fill in the four Discord and
# session values below. Everything else already matches `pnpm dev`.
# Servers use .env.prod.example instead.

# ── Fill these in ────────────────────────────────────────────────────────────
# From https://discord.com/developers/applications → your app (see README.md).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# Any long random string: openssl rand -hex 32
SESSION_COOKIE_SECRET=

# Your Discord user ID (comma-separate several). Admins see every server's games
# without the bot having to confirm membership, and may import games.
ADMIN_DISCORD_IDS=

# ── Defaults for pnpm dev ────────────────────────────────────────────────────
# The Postgres from docker-compose.dev.yml.
DATABASE_URL=postgresql://taibled:devpassword@localhost:5433/taibled
# Register this exact URL under OAuth2 → Redirects in your Discord app.
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback
# The web dev server (CORS allows exactly this origin).
FRONTEND_ORIGIN=http://localhost:4321
# Where the web app calls the API.
PUBLIC_API_BASE=http://localhost:3000

# ── Optional ─────────────────────────────────────────────────────────────────
# Overpass server for free play and OSM boundary lookups (default: public ones).
# OVERPASS_URL=
# Largest Overpass response the API reads, in bytes (default: 52428800, 50 MiB).
# OVERPASS_MAX_RESPONSE_BYTES=

# VPS PRODUCTION env — copy to .env on the VPS and fill in, then `chmod 600 .env`.
# Never commit .env. Used by docker-compose.yml + docker-compose.vps.yml.

# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_USER=taibled
POSTGRES_PASSWORD=change_me_strong_password
DATABASE_URL=postgresql://taibled:change_me_strong_password@postgres:5432/taibled

# ── Discord OAuth ─────────────────────────────────────────────────────────────
DISCORD_CLIENT_ID=1506413333774073866
DISCORD_CLIENT_SECRET=fill_me
# Must be registered in the Discord developer portal (see DEPLOY.md):
# NOTE: single-label `api-searchlight` host — Cloudflare free Universal SSL does
# not cover two-level subdomains (`api.searchlight…` fails the TLS handshake).
DISCORD_REDIRECT_URI=https://api-searchlight.jetlageuropa.org/auth/discord/callback
DISCORD_BOT_TOKEN=fill_me

# ── Sessions ──────────────────────────────────────────────────────────────────
# Generate a fresh one: openssl rand -hex 32
SESSION_COOKIE_SECRET=fill_me
# Leave blank — SameSite=None+Secure handles the web/api subdomain split.
SESSION_COOKIE_DOMAIN=

# ── CORS / origins ────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=https://searchlight.jetlageuropa.org
# The web build takes its API host from docker-compose.vps.yml (and CI), not
# from here; this only keeps Compose from warning that it is unset.
PUBLIC_API_BASE=https://api-searchlight.jetlageuropa.org

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=production

# Discord user IDs with every permission on every server (comma-separated).
ADMIN_DISCORD_IDS=486092125969317898

# ── Feedback webhook (optional) ───────────────────────────────────────────────
DISCORD_FEEDBACK_WEBHOOK_URL=fill_me

# ── Self-hosted Overpass (optional) ───────────────────────────────────────────
# Used only for free play (no game selected) and OSM boundary lookups; games
# never query Overpass. Unset, the public Overpass servers are used. The
# CF_ACCESS pair is the Cloudflare Access service token, if the instance sits
# behind Access.
# OVERPASS_URL=https://<your-overpass-host>/api/interpreter
# OVERPASS_CF_ACCESS_CLIENT_ID=
# OVERPASS_CF_ACCESS_CLIENT_SECRET=

# ── Docker images ─────────────────────────────────────────────────────────────
# infra/deploy-vps.sh pulls the api/web images CI pushes to GHCR (see
# DEPLOY.md). Set this only if they're pushed under another owner (a fork).
# SEARCHLIGHT_IMAGE_REGISTRY=ghcr.io/<owner>

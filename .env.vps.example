# VPS PRODUCTION env — copy to .env on the VPS and fill in, then `chmod 600 .env`.
# Never commit .env. Used by docker-compose.yml + docker-compose.vps.yml.

# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_USER=taibled
POSTGRES_PASSWORD=change_me_strong_password
DATABASE_URL=postgresql://taibled:change_me_strong_password@postgres:5432/taibled

# ── Discord OAuth ─────────────────────────────────────────────────────────────
DISCORD_CLIENT_ID=1506413333774073866
DISCORD_CLIENT_SECRET=fill_me
# Must be registered in the Discord developer portal (see VPS_Setup.md):
# NOTE: single-label `api-searchlight` host — Cloudflare free Universal SSL does
# not cover two-level subdomains (`api.searchlight…` fails the TLS handshake).
DISCORD_REDIRECT_URI=https://api-searchlight.jetlageuropa.org/auth/discord/callback
DISCORD_BOT_TOKEN=fill_me

# ── Sessions ──────────────────────────────────────────────────────────────────
# Generate a fresh one: openssl rand -hex 32
SESSION_COOKIE_SECRET=fill_me
# Leave blank — SameSite=None+Secure handles the web/api subdomain split.
SESSION_COOKIE_DOMAIN=

# ── CORS / origins ────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=https://searchlight.jetlageuropa.org
# The web build takes its API host from docker-compose.vps.yml, not from here.
PUBLIC_API_BASE=https://api-searchlight.jetlageuropa.org

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=production

# Discord user IDs with every permission on every server (comma-separated).
ADMIN_DISCORD_IDS=486092125969317898

# ── Feedback webhook (optional) ───────────────────────────────────────────────
DISCORD_FEEDBACK_WEBHOOK_URL=fill_me

# ── Self-hosted Overpass (stays on the Mac mini, public via Cloudflare Access) ─
# Used only for free play (no game selected); games never query Overpass.
OVERPASS_URL=https://overpass.lucifersserver.com/api/interpreter
OVERPASS_CF_ACCESS_CLIENT_ID=fill_me.access
OVERPASS_CF_ACCESS_CLIENT_SECRET=fill_me

# ── Docker images ─────────────────────────────────────────────────────────────
# infra/deploy-vps.sh pulls the api/web images CI pushes to GHCR (see
# VPS_Setup.md). Set this only if they're pushed under another owner (a fork).
# SEARCHLIGHT_IMAGE_REGISTRY=ghcr.io/leandrocoding

# ── Cloudflare Tunnel ─────────────────────────────────────────────────────────
# The live VPS uses a LOCALLY-MANAGED tunnel (created with `cloudflared tunnel
# login` + `tunnel create` on the VPS). Credentials + ingress live in
# /srv/WriteMap/cloudflared/config.yml, mounted read-only into the container by
# docker-compose.vps.yml — so TUNNEL_TOKEN is NOT used and is left unset.
# Only set this if you switch to a dashboard token-managed tunnel instead.
# TUNNEL_TOKEN=fill_me
